---
// Detail page template for every app that has a release. The hero, quick facts
// and "More" links come from frontmatter; the sections in between are the MDX body.
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import Section from '../../components/Section.astro';
import Question from '../../components/Question.astro';
import FeatureList from '../../components/FeatureList.astro';
import StepList from '../../components/StepList.astro';
import { getApps, hasPage, type App } from '../../lib/apps';
import { appSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const apps = await getApps();
  return apps.filter(hasPage).map((app) => ({ params: { app: app.id }, props: { app } }));
}

interface Props {
  app: App;
}

const { app } = Astro.props;
const { name, icon, tagline, intro, description, ogDescription, version, minAndroid, download, source, status, internet, released, changes } = app.data;
const { Content } = await render(app);

const facts = [
  'Free, no ads',
  ...(internet ? ['Uses the internet'] : ['Works offline', 'No internet permission']),
  `Android ${minAndroid} or newer`,
  status === 'test' ? `Version ${version}, test release` : `Version ${version}`,
];

// Link preview image in public/assets/og/<icon>.png, or the Niko one if the app has none yet.
const ogImage = existsSync(`public/assets/og/${icon}.png`) ? `/assets/og/${icon}.png` : undefined;
const releasedText = released!.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title={`${name} · ${tagline!.replace(/\.$/, '')}`}
  description={description!}
  ogDescription={ogDescription}
  ogImage={ogImage}
  jsonLd={appSchema(app)}
>
  <Hero slot="header" title={name} lead={tagline!}>
    <img slot="image" class="mx-auto size-32 rounded-[32px]" src={`/assets/icons/${icon}.svg`} alt="" width="128" height="128">
    <p>{intro}</p>
    <p class="mt-4"><Button href={download!}>Download for Android</Button></p>
    <ul class="mt-4 flex flex-wrap justify-center gap-2">
      {facts.map((fact) => <li class="rounded-full bg-surface px-3.5 py-1.5 text-sm text-muted">{fact}</li>)}
    </ul>
  </Hero>

  <Content components={{ Section, Question, ul: FeatureList, ol: StepList }} />

  {changes && (
    <Section id="new" title={`What's new in ${version}`}>
      <p class="text-sm text-muted">Released {releasedText}.</p>
      <ul class="list-disc pl-6 [&>li]:py-1">
        {changes.map((change) => <li>{change}</li>)}
      </ul>
    </Section>
  )}

  <Section id="more" title="More">
    <ul class="[&>li]:py-2">
      <li><a href={`${source}/releases`}>All releases and what changed</a></li>
      <li><a href={`${source}/issues`}>Report a problem or ask a question</a></li>
      <li><a href={source}>Source code</a> (GPLv3)</li>
    </ul>
  </Section>
</BaseLayout>
