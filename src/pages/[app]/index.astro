---
// Detail page template for every app that has a release. The hero and the
// "More" links come from frontmatter; the sections in between are the MDX body.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FeatureList from '../../components/FeatureList.astro';
import StepList from '../../components/StepList.astro';
import { getApps, hasPage, type App } from '../../lib/apps';

export async function getStaticPaths() {
  const apps = await getApps();
  return apps.filter(hasPage).map((app) => ({ params: { app: app.id }, props: { app } }));
}

interface Props {
  app: App;
}

const { app } = Astro.props;
const { name, icon, tagline, intro, description, ogDescription, version, minAndroid, download, source, status } = app.data;
const { Content } = await render(app);
const statusText = status === 'test' ? `Version ${version}, test release.` : `Version ${version}.`;
---
<BaseLayout title={name} description={description!} ogDescription={ogDescription} backLink>
  <nav class="crumb"><a href="/">Niko</a> / {name}</nav>
  <header class="hero">
    <img class="app-icon" src={`/assets/icons/${icon}.svg`} alt="" width="128" height="128">
    <h1>{name}</h1>
    <p class="lead">{tagline}</p>
    <p>{intro}</p>
    <p><a class="button" href={download}>Download for Android</a></p>
    <p class="status">{statusText} Android {minAndroid} or newer.</p>
  </header>

  <main id="main">
    <Content components={{ Section, ul: FeatureList, ol: StepList }} />

    <section aria-labelledby="more">
      <h2 id="more">More</h2>
      <ul class="links">
        <li><a href={source}>Source code</a> (GPLv3)</li>
        <li><a href={`${source}/issues`}>Report a problem or ask a question</a></li>
        <li><a href={`${source}/releases`}>All releases and what changed</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
