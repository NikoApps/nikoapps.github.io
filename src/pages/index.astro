---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Points from '../components/Points.astro';
import { getApps, hasPage, statusLabel } from '../lib/apps';
import { website } from '../lib/seo';

const apps = await getApps();
const available = apps.filter(hasPage);
const planned = apps.filter((app) => !hasPage(app));
---
<BaseLayout
  title="Niko · Simple, free Android apps anyone can use"
  description="Simple, free Android apps that anyone can use. No ads, no tracking, built for accessibility."
  jsonLd={website}
>
  <Hero slot="header" title="Niko" lead="Simple, free Android apps that anyone can use.">
    <img slot="image" class="mx-auto size-40" src="/assets/niko-mark.svg" alt="" width="160" height="160">
    <p>For people who can't read, older people and disabled people. Each app does one job, speaks out loud and works offline.</p>
  </Hero>

  <Section id="apps" title="Apps you can try">
    <ul>
      {available.map((app) => (
        <li class="mb-3 flex flex-col items-start gap-4 rounded-2xl bg-surface p-4 sm:flex-row">
          <img class="size-24 flex-none rounded-3xl" src={`/assets/icons/${app.data.icon}.svg`} alt="" width="96" height="96" />
          <div>
            <h3 class="text-xl font-bold"><a class="text-ink" href={`/${app.id}/`}>{app.data.name}</a></h3>
            <p>{app.data.summary}</p>
            <p class="text-sm text-muted">{statusLabel[app.data.status]}, version {app.data.version}</p>
            <p class="mt-3 flex flex-wrap gap-3 [&>a]:grow sm:[&>a]:grow-0">
              <Button href={app.data.download!}>Download</Button>
              <Button href={`/${app.id}/`} secondary>Learn more</Button>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p>New to installing apps from outside the Play Store? <a href="/install/">See how to install</a>.</p>
  </Section>

  <Section id="coming" title="Coming later">
    <ul>
      {planned.map((app) => (
        <li class="mb-2 flex items-start gap-4 rounded-2xl bg-surface px-4 py-3">
          <img class="size-14 flex-none rounded-2xl" src={`/assets/icons/${app.data.icon}.svg`} alt="" width="56" height="56" />
          <div>
            <h3 class="text-xl font-bold">{app.data.name}</h3>
            <p>{app.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="promise" title="Every Niko app">
    <Points>
      <li><strong>Is free.</strong> No ads, no paid features.</li>
      <li><strong>Keeps your data on the phone.</strong> No tracking, no accounts. <a href="/privacy/">Privacy</a></li>
      <li><strong>Can be used without reading.</strong> It speaks in the phone's own voice and language. <a href="/accessibility/">Accessibility</a></li>
      <li><strong>Is open source.</strong> Published under GPLv3 when it is released. <a href="/about/">About Niko</a></li>
    </Points>
  </Section>
</BaseLayout>
