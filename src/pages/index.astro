---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getApps, hasPage, statusLabel } from '../lib/apps';

const apps = await getApps();
const available = apps.filter(hasPage);
const planned = apps.filter((app) => !hasPage(app));
---
<BaseLayout
  title="Niko"
  description="Simple, free Android apps that anyone can use. No ads, no tracking, built for accessibility."
>
  <header class="hero">
    <img src="/assets/niko-mark.svg" alt="" width="160" height="160">
    <h1>Niko</h1>
    <p class="lead">Simple, free Android apps that anyone can use.</p>
    <p>For people who can't read, older people and disabled people. Each app does one job, speaks out loud and works offline.</p>
  </header>

  <main id="main">
    <section aria-labelledby="apps">
      <h2 id="apps">Apps you can try</h2>
      <ul class="apps">
        {available.map((app) => (
          <li class="app-card">
            <img src={`/assets/icons/${app.data.icon}.svg`} alt="" width="96" height="96" />
            <div>
              <h3><a href={`/${app.id}/`}>{app.data.name}</a></h3>
              <p>{app.data.summary}</p>
              <p class="status">{statusLabel[app.data.status]}, version {app.data.version}</p>
              <p class="actions">
                <a class="button" href={app.data.download}>Download</a>
                <a class="button secondary" href={`/${app.id}/`}>Learn more</a>
              </p>
            </div>
          </li>
        ))}
      </ul>
      <p>New to installing apps from outside the Play Store? <a href="/install/">See how to install</a>.</p>
    </section>

    <section aria-labelledby="coming">
      <h2 id="coming">Coming later</h2>
      <ul class="apps compact">
        {planned.map((app) => (
          <li>
            <img src={`/assets/icons/${app.data.icon}.svg`} alt="" width="56" height="56" />
            <div>
              <h3>{app.data.name}</h3>
              <p>{app.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="promise">
      <h2 id="promise">Every Niko app</h2>
      <ul class="promise">
        <li><strong>Is free.</strong> No ads, no paid features.</li>
        <li><strong>Keeps your data on the phone.</strong> No tracking, no accounts. <a href="/privacy/">Privacy</a></li>
        <li><strong>Can be used without reading.</strong> It speaks in the phone's own voice and language. <a href="/accessibility/">Accessibility</a></li>
        <li><strong>Is open source.</strong> Published under GPLv3 when it is released. <a href="/about/">About Niko</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
