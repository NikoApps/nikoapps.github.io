---
// Shared page shell: head, skip link, top bar, main and footer. Pages put a
// <Hero slot="header"> first and their sections in the default slot.
import '../styles/global.css';
import { organization } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  // Link preview image, 1200 by 630, from public/.
  ogImage?: string;
  // Structured data for search engines, added as JSON-LD.
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  ogDescription = description,
  ogImage = '/assets/og/niko.png',
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(ogImage, Astro.site).href;
const path = Astro.url.pathname;
// Every page says who publishes it. Pages can add more, such as an app.
const schema = [organization, ...(jsonLd ? [jsonLd] : [])];
// Keep "</script>" inside a string from closing the tag early.
const schemaJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replaceAll('<', '\\u003c');

const nav = [
  { href: '/#apps', label: 'Apps' },
  { href: '/install/', label: 'Install' },
  { href: '/about/', label: 'About' },
];

const footerLinks = [
  { href: '/', label: 'All apps' },
  { href: '/install/', label: 'Install help' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/about/', label: 'About' },
  { href: 'https://github.com/NikoApps', label: 'GitHub' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline>
    // Apply a saved theme before the page paints, so it doesn't flash.
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch {}
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="google-site-verification" content="6UCsXdFyzHKD8Bq3xL90LKew3UaoIM7pezXmMaQd0yc">
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#FBF8FF" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1A1E2B" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/icon-192.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="alternate" type="application/rss+xml" title="Niko app releases" href="/rss.xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Niko">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={schemaJson} />
</head>
<body>
  <a class="absolute -left-[999px] bg-accent px-4 py-3 text-on-accent focus:top-4 focus:left-4" href="#main">Skip to content</a>
  <div class="mx-auto flex max-w-176 flex-wrap items-center gap-x-2 gap-y-1 px-4 pt-3">
    <a class="order-1 mr-auto inline-flex min-h-12 items-center gap-2.5 text-xl font-bold text-ink no-underline" href="/">
      <img class="size-10" src="/assets/niko-mark.svg" alt="" width="40" height="40">Niko
    </a>
    <nav aria-label="Main" class="order-3 w-full sm:order-2 sm:w-auto">
      <ul class="-ml-3 flex gap-1 sm:ml-0">
        {nav.map((item) => (
          <li>
            <a class="inline-block min-h-12 rounded-xl px-3 py-2.5 aria-[current=page]:font-bold aria-[current=page]:decoration-3" href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {/* Hidden until the script below runs. Without JavaScript the site follows the system theme. */}
    <button id="theme" type="button" hidden class="group order-2 inline-flex min-h-12 min-w-12 cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-outline px-3 text-link sm:order-3">
      {/* Moon when switching to dark, sun when switching to light. */}
      <svg class="hidden size-5 group-data-[target=dark]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="hidden size-5 group-data-[target=light]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      {/* On phones only the icon shows; screen readers still hear the full label. */}
      <span class="max-sm:sr-only"><span class="sr-only">Switch to </span><span id="theme-label">Dark</span> theme</span>
    </button>
  </div>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const button = document.getElementById('theme');
      const label = document.getElementById('theme-label');
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');
      const show = () => {
        const target = current() === 'dark' ? 'light' : 'dark';
        button.dataset.target = target;
        label.textContent = target === 'light' ? 'Light' : 'Dark';
      };
      button.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        show();
      });
      systemDark.addEventListener('change', show);
      show();
      button.hidden = false;
    })();
  </script>
  <slot name="header" />
  <main id="main" class="mx-auto max-w-176 px-4">
    <slot />
  </main>
  <script is:inline>
    // Links to a question open it, opening a question puts its link in the
    // address bar, and the address bar follows the section being read, so any
    // link copied from it leads back to the same place.
    (() => {
      const setHash = (id) => history.replaceState(null, '', id ? `#${id}` : location.pathname);
      const openTarget = () => {
        const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        const details = target && target.closest('details');
        if (details) {
          details.open = true;
          target.scrollIntoView();
        }
      };
      openTarget();
      addEventListener('hashchange', openTarget);

      let current = location.hash.slice(1);
      for (const details of document.querySelectorAll('main details[id]')) {
        details.addEventListener('toggle', () => {
          if (!details.open) return;
          current = details.id;
          setHash(details.id);
        });
      }

      const headings = [...document.querySelectorAll('main section > h2[id]')];
      if (!headings.length) return;
      const update = () => {
        // The section whose heading was passed last, or none above the first one.
        const passed = headings.filter((h) => h.getBoundingClientRect().top < innerHeight * 0.3);
        const id = passed.length ? passed[passed.length - 1].id : '';
        // Keep a question's link while the reader is still in its section.
        const inQuestion = current && document.getElementById(current)?.closest('section')?.querySelector('h2')?.id === id;
        if (id !== current && !inQuestion) {
          current = id;
          setHash(id);
        }
      };
      let queued = false;
      addEventListener('scroll', () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; update(); });
      }, { passive: true });
    })();
  </script>
  <footer class="mx-auto max-w-176 px-4 pt-8 pb-12 text-muted">
    <nav aria-label="Footer">
      <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-1">
        {footerLinks.map((item) => <li><a class="inline-block py-2.5" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <p>Free Android apps, made in Nepal. Contact: <a href="mailto:hello@gopalkhadka.com.np">hello@gopalkhadka.com.np</a></p>
  </footer>
</body>
</html>
