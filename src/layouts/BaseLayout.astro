---
// Shared page shell: head, skip link, top bar, main and footer. Pages put a
// <Hero slot="header"> first and their sections in the default slot.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
}

const { title, description, ogDescription = description } = Astro.props;
const ogImage = new URL('/assets/icon-192.png', Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/#apps', label: 'Apps' },
  { href: '/install/', label: 'Install' },
  { href: '/about/', label: 'About' },
];

const footerLinks = [
  { href: '/', label: 'All apps' },
  { href: '/install/', label: 'Install help' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/about/', label: 'About' },
  { href: 'https://github.com/NikoApps', label: 'GitHub' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/icon-192.png">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
</head>
<body>
  <a class="absolute -left-[999px] bg-accent px-4 py-3 text-on-accent focus:top-4 focus:left-4" href="#main">Skip to content</a>
  <div class="mx-auto flex max-w-176 flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-3">
    <a class="inline-flex min-h-12 items-center gap-2.5 text-xl font-bold text-ink no-underline" href="/">
      <img class="size-10" src="/assets/niko-mark.svg" alt="" width="40" height="40">Niko
    </a>
    <nav aria-label="Main">
      <ul class="flex gap-1">
        {nav.map((item) => (
          <li>
            <a class="inline-block min-h-12 rounded-xl px-3 py-2.5 aria-[current=page]:font-bold aria-[current=page]:decoration-3" href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <slot name="header" />
  <main id="main" class="mx-auto max-w-176 px-4">
    <slot />
  </main>
  <footer class="mx-auto max-w-176 px-4 pt-8 pb-12 text-muted">
    <nav aria-label="Footer">
      <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-1">
        {footerLinks.map((item) => <li><a class="inline-block py-2" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <p>Free Android apps, made in Nepal. Contact: <a href="mailto:hello@gopalkhadka.com.np">hello@gopalkhadka.com.np</a></p>
  </footer>
</body>
</html>
