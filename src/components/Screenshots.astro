---
// A row of phone screenshots. Scrolls sideways on phones and wraps into a
// grid on wider screens. Images live in public/assets/screenshots/<app>/.
interface Props {
  app: string;
  shots: { file: string; alt: string }[];
}

const { app, shots } = Astro.props;
---
<div
  class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0"
  role="region"
  aria-label="Screenshots"
  tabindex="0"
>
  {shots.map((shot) => (
    <img
      class="w-56 flex-none snap-start rounded-2xl border-2 border-outline/20 sm:w-full"
      src={`/assets/screenshots/${app}/${shot.file}`}
      alt={shot.alt}
      loading="lazy"
      decoding="async"
    />
  ))}
</div>
