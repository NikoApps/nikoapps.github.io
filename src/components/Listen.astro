---
// Reads a short summary out loud with the browser's own voice, for visitors
// who don't read well. Hidden in browsers that can't speak.
interface Props {
  text: string;
}

const { text } = Astro.props;
---
<button
  type="button"
  hidden
  data-listen={text}
  class="mt-3 inline-flex min-h-16 cursor-pointer items-center justify-center gap-2 rounded-2xl border-2 border-outline px-7 font-bold text-link"
>
  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
  <span data-listen-label>Listen</span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-listen]')) {
    if (!('speechSynthesis' in window)) continue;
    const label = button.querySelector('[data-listen-label]')!;
    const show = (speaking: boolean) => { label.textContent = speaking ? 'Stop' : 'Listen'; };
    button.addEventListener('click', () => {
      if (speechSynthesis.speaking) {
        speechSynthesis.cancel();
        show(false);
        return;
      }
      const speech = new SpeechSynthesisUtterance(button.dataset.listen);
      speech.lang = document.documentElement.lang;
      speech.rate = 0.9;
      speech.onend = () => show(false);
      speechSynthesis.speak(speech);
      show(true);
    });
    button.hidden = false;
  }
</script>
