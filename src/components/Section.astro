---
// A titled section. Use it in pages and app MDX files:
// <Section id="install" title="Install"> ... </Section>
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---
<section aria-labelledby={id}>
  <h2 id={id} class="mt-10 mb-4 text-2xl font-bold">{title}</h2>
  <slot />
</section>
